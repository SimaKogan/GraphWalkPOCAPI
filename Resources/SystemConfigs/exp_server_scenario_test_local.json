{
  "general": {
    "save_path": "Resources/Experiments",
    "embedding_model_name": "text-multilingual-embedding-002",
    "restrictions_path": "Resources/PromptConfigs/restriction.json",
    "orc_mode": "local",
    "max_workers": 5
  },
  "specs": {
    "tools_path": "Resources/Specs/transit_tools.json",
    "actions_path": "Resources/Specs/transit_actions.json",
    "endpoints_path": "Resources/Specs/transit_endpoints.json",
    "states_path": "Resources/Specs/transit_states.json",
    "blocks_path": "Resources/Specs/transit_blocks.json",
