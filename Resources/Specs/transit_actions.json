    "compute_balance_after_renewal": {
      "description": "Compute what is left on the card after paying for the renewal",
      "steps": [
        {
          "tool_name": "reduce",
          "return_data": "balance_after_renewal",
          "params": {
            "val_a": {
              "value": "GetCardBalance_response.balance.value",
              "arg_type": "param"
            },
            "val_b": {
              "value": "GetPassRenewalOptions_response.renewalPrice.value",
              "arg_type": "param"
            },
            "operator": {
              "value": "subtract",
              "arg_type": "value"
            }
          }
        }
      ],
      "params": {
        "GetCardBalance_response": {
          "type": "dict",
          "description": "Card balance (balance)"
        },
        "GetPassRenewalOptions_response": {
          "type": "dict",
          "description": "Renewal terms (renewalPrice)"
        }
      },
      "doc_outputs": {
        "balance_after_renewal": {
          "type": "float",
          "description": "Card balance after paying for the renewal (ILS)",
          "main_return": true
        }
