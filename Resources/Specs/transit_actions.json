{
  "actions": {
    "get_selected_option_from_user": {
      "description": "Display a list of options to the user and return the selected option",
      "steps": [
        {
          "tool_name": "get_selection_from_user",
          "return_data": "selected_index",
          "params": {
            "options": {
              "value": "options",
              "arg_type": "param"
            },
            "prompt": {
              "value": "prompt",
              "arg_type": "param"
            },
            "description": {
              "value": "Index of the relevant row",
              "arg_type": "value"
            },
            "return_keys": {
              "value": [
                "selected_index"
              ],
              "arg_type": "value"
            },
            "return_types": {
              "value": [
                "int"
              ],
              "arg_type": "value"
            }
          }
        },
        {
          "tool_name": "select_option",
          "return_data": "selected_option_details",
          "params": {
            "options": {
              "value": "options",
              "arg_type": "param"
            },
            "selected_index": {
              "value": "selected_index",
              "arg_type": "param"
            }
          }
        }
      ],
      "params": {
        "options": {
          "type": "list",
          "description": "Options to display to the user"
        },
        "prompt": {
          "type": "str",
          "description": "Selection prompt to display to the user"
        }
      },
      "doc_outputs": {
        "selected_option_details": {
          "type": "dict",
          "description": "Selected option details",
          "main_return": false
        }
      }
    },
    "select_trip": {
      "description": "Fetch the rider's recent trips and let the rider pick one",
      "steps": [
        {
          "tool_name": "get_user_id",
          "return_data": "user_id",
          "params": {}
        },
        {
          "tool_name": "send_request",
          "return_data": "GetTripHistory_response",
          "params": {
            "endpoint": {
              "value": "GetTripHistory",
              "arg_type": "value"
            },
            "add_kwargs": {
              "value": {
                "riderId": {
                  "value": "user_id",
                  "arg_type": "param"
                },
                "daysBack": {
                  "value": 30,
                  "arg_type": "value"
                }
              },
              "arg_type": "dict"
            }
          }
        },
        {
          "tool_name": "get_selected_option_from_user",
          "return_data": {
            "selected_index": "selected_trip_index",
            "selected_option_details": "selected_trip_details"
          },
          "params": {
            "options": {
              "value": "GetTripHistory_response.result",
              "arg_type": "param"
            },
            "prompt": {
              "value": "### הנסיעות האחרונות שלך (30 הימים האחרונים)\n\nאנא בחר/י את הנסיעה הרלוונטית. הקלד/י את מספר השורה.\nאם הנסיעה לא מופיעה ברשימה, אנא פנה/י לשירות הלקוחות.",
              "arg_type": "value"
            }
          }
        }
      ],
      "params": {},
      "doc_outputs": {
        "selected_trip_details": {
          "type": "response_dict",
          "description": "Details of the trip the rider selected",
          "main_return": true
        },
        "GetTripHistory_response": {
          "type": "response_dict",
          "description": "Response from GetTripHistory",
          "main_return": false
        }
      }
    },
