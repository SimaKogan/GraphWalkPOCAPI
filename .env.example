# Google Cloud / Vertex AI (every LLM call)
GOOGLE_CLOUD_PROJECT=
VERTEXAI_LOCATION=us-central1

# Neo4j
NEO4J_URI=
NEO4J_USER=
NEO4J_PASSWORD=

# Web session signing
SESSION_SECRET=

# Transit API (the local mock accepts the default token)
TRANSIT_API_TOKEN=dev-token

# General route: Postgres / Weaviate
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=
WEAVIATE_URL=http://localhost:8080
